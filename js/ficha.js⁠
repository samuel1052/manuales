// Cargar borrador o inicializar
function initFichaTecnica() {
  const saved = localStorage.getItem(STORAGE_KEY);
  if (saved) {
    try {
      fichaState = Object.assign({}, fichaState, JSON.parse(saved));
    } catch (e) {
      console.error("Error al cargar borrador local:", e);
    }
  }
  
  // Rellenar formulario inicial si no hay zonas creadas
  if (fichaState.zonas.length === 0 && fichaState.tipoInstalacion === 'Alarma') {
    // Zonas de ejemplo iniciales si está vacío
    fichaState.zonas = [
      { id: Date.now() + 1, numero: '01', nombre: 'Entrada principal', detector: 'PIR', ubicacion: 'Recibidor', tipoZona: 'Retardada', particion: '1', estado: 'Activa', observaciones: '' },
      { id: Date.now() + 2, numero: '02', nombre: 'Salón', detector: 'PIR', ubicacion: 'Salón', tipoZona: 'Instantánea', particion: '1', estado: 'Activa', observaciones: '' }
    ];
  }

  renderFichaForm();
  bindFichaEvents();
}

// Guardado automático en localStorage
function saveDraft() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(fichaState));
  showToast('Cambios guardados localmente');
}

// Mostrar Toast/Notificación temporal
function showToast(msg) {
  let toast = document.getElementById('ft-toast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'ft-toast';
    toast.className = 'ft-toast';
    document.body.appendChild(toast);
  }
  toast.innerText = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 2000);
}

