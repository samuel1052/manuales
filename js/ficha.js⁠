// Vinculación de eventos dinámicos
function bindFichaEvents() {
  // Cambio de tipo de instalación
  const selTipo = document.getElementById('ft-tipo-instalacion');
  if (selTipo) {
    selTipo.addEventListener('change', (e) => {
      fichaState.tipoInstalacion = e.target.value;
      saveDraft();
      renderFichaForm();
    });
  }

  // Evento Generar Ficha
  const btnGenerar = document.getElementById('btn-generar-ficha');
  if (btnGenerar) {
    btnGenerar.addEventListener('click', generarTextoFicha);
  }

  // Borrar Ficha
  const btnBorrar = document.getElementById('btn-borrar-ficha');
  if (btnBorrar) {
    btnBorrar.addEventListener('click', () => {
      if (confirm('¿Estás seguro de que deseas borrar todos los datos de esta ficha? Esta acción no se puede deshacer.')) {
        localStorage.removeItem(STORAGE_KEY);
        fichaState.zonas = [];
        fichaState.camaras = [];
        fichaState.datosGenerales = { fabricante: '', modelo: '', numSerie: '', firmware: '', mac: '', ip: '', mascara: '', gateway: '', dns: '', fecha: new Date().toISOString().split('T')[0], tecnico: '', observaciones: '' };
        renderFichaForm();
        showToast('Ficha borrada correctamente');
      }
    });
  }

  // Nueva Ficha
  const btnNueva = document.getElementById('btn-nueva-ficha');
  if (btnNueva) {
    btnNueva.addEventListener('click', () => {
      if (confirm('¿Deseas iniciar una nueva ficha desde cero?')) {
        fichaState.zonas = [];
        fichaState.camaras = [];
        fichaState.datosGenerales.numSerie = '';
        fichaState.datosGenerales.observaciones = '';
        saveDraft();
        renderFichaForm();
      }
    });
  }
}

// Escuchar cambios en campos
function attachDynamicListeners() {
  // Inputs generales
  ['fabricante', 'modelo', 'numSerie', 'firmware', 'ip', 'mac', 'mascara', 'gateway', 'dns', 'fecha', 'tecnico', 'observaciones'].forEach(prop => {
    const el = document.getElementById(`gen-${prop}`);
    if (el) {
      el.addEventListener('input', (e) => {
        fichaState.datosGenerales[prop] = e.target.value;
        saveDraft();
      });
    }
  });

  // Nombres de Particiones
  document.querySelectorAll('.ft-part-name').forEach(el => {
    el.addEventListener('input', (e) => {
      const part = e.target.getAttribute('data-part');
      fichaState.particionesNombres[part] = e.target.value;
      saveDraft();
    });
  });

  // Añadir Zona
  const btnAddZona = document.getElementById('btn-add-zona');
  if (btnAddZona) {
    btnAddZona.addEventListener('click', () => {
      const nextNum = String(fichaState.zonas.length + 1).padStart(2, '0');
      fichaState.zonas.push({
        id: Date.now(),
        numero: nextNum,
        nombre: `Zona ${nextNum}`,
        detector: 'PIR',
        ubicacion: 'Interior',
        tipoZona: 'Instantánea',
        particion: '1',
        estado: 'Activa',
        observaciones: ''
      });
      saveDraft();
      renderFichaForm();
    });
  }

  // Modificar propiedades de Zonas
  document.querySelectorAll('.ft-z-val').forEach(el => {
    el.addEventListener('change', (e) => {
      const idx = parseInt(e.target.getAttribute('data-idx'));
      const prop = e.target.getAttribute('data-prop');
      if (fichaState.zonas[idx]) {
        fichaState.zonas[idx][prop] = e.target.value;
        saveDraft();
      }
    });
  });

  // Duplicar Zona
  document.querySelectorAll('.btn-duplicar-zona').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const idx = parseInt(e.target.getAttribute('data-idx'));
      const original = fichaState.zonas[idx];
      if (original) {
        const nextNum = String(fichaState.zonas.length + 1).padStart(2, '0');
        const copia = Object.assign({}, original, {
          id: Date.now(),
          numero: nextNum,
          nombre: `${original.nombre} (Copia)`
        });
        fichaState.zonas.splice(idx + 1, 0, copia);
        saveDraft();
        renderFichaForm();
        showToast(`Zona ${original.numero} duplicada`);
      }
    });
  });

  // Eliminar Zona
  document.querySelectorAll('.btn-eliminar-zona').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const idx = parseInt(e.target.getAttribute('data-idx'));
      fichaState.zonas.splice(idx, 1);
      saveDraft();
      renderFichaForm();
    });
  });

  // Añadir Cámara CCTV
  const btnAddCam = document.getElementById('btn-add-camara');
  if (btnAddCam) {
    btnAddCam.addEventListener('click', () => {
      const nextNum = String(fichaState.camaras.length + 1).padStart(2, '0');
      fichaState.camaras.push({
        numero: nextNum,
        modelo: 'Cámara IP 2MP',
        numSerie: '',
        ip: `192.168.1.${100 + fichaState.camaras.length}`,
        ubicacion: 'Exterior',
        canal: `CH${fichaState.camaras.length + 1}`
      });
      saveDraft();
      renderFichaForm();
    });
  }

  // Eliminar Cámara
  document.querySelectorAll('.btn-eliminar-camara').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const idx = parseInt(e.target.getAttribute('data-cidx'));
      fichaState.camaras.splice(idx, 1);
      saveDraft();
      renderFichaForm();
    });
  });

  // Eventos Exportación / Copiar / Compartir / Notas
  const btnCopiar = document.getElementById('btn-copiar-ficha');
  if (btnCopiar) {
    btnCopiar.addEventListener('click', copiarAlPortapapeles);
  }

  const btnCompartir = document.getElementById('btn-compartir-ficha');
  if (btnCompartir) {
    btnCompartir.addEventListener('click', compartirFicha);
  }

  const btnNotas = document.getElementById('btn-notas-ficha');
  if (btnNotas) {
    btnNotas.addEventListener('click', guardarEnNotasApple);
  }
}

// 📝 Generar Documento de Ficha Técnica
function generarTextoFicha() {
  const g = fichaState.datosGenerales;
  let txt = `🔧 FICHA TÉCNICA DE INSTALACIÓN\n`;
  txt += `===================================\n`;
  txt += `TIPO: ${fichaState.tipoInstalacion.toUpperCase()}\n`;
  txt += `FECHA: ${g.fecha || 'N/A'}\n`;
  txt += `TÉCNICO: ${g.tecnico || 'N/A'}\n\n`;

  txt += `📌 DATOS DEL EQUIPO PRINCIPAL\n`;
  txt += `Fabricante: ${g.fabricante || '-'}\n`;
  txt += `Modelo: ${g.modelo || '-'}\n`;
  txt += `N/S: ${g.numSerie || '-'}\n`;
  txt += `Firmware: ${g.firmware || '-'}\n`;
  txt += `IP: ${g.ip || '-'} | MAC: ${g.mac || '-'}\n`;
  txt += `Red: Máscara ${g.mascara || '-'} | Gateway ${g.gateway || '-'}\n\n`;

  if (fichaState.tipoInstalacion === 'Alarma') {
    txt += `🚨 PROGRAMACIÓN DE ZONAS (${fichaState.zonas.length})\n`;
    txt += `-----------------------------------\n`;
    fichaState.zonas.forEach(z => {
      const aliasPart = fichaState.particionesNombres[z.particion] ? ` (${fichaState.particionesNombres[z.particion]})` : '';
      txt += `ZONA ${z.numero} — ${z.nombre}\n`;
      txt += `  • Detector: ${z.detector}\n`;
      txt += `  • Ubicación: ${z.ubicacion}\n`;
      txt += `  • Tipo de Zona: ${z.tipoZona}\n`;
      txt += `  • Partición: Partición ${z.particion}${aliasPart}\n`;
      txt += `  • Estado: ${z.estado}\n\n`;
    });

    if (fichaState.comunicador.modelo || fichaState.comunicador.tipo) {
      txt += `📡 COMUNICADOR\n`;
      txt += `Tipo: ${fichaState.comunicador.tipo} | Modelo: ${fichaState.comunicador.modelo || '-'}\n`;
      txt += `Operador/SIM: ${fichaState.comunicador.operador || '-'}\n\n`;
    }
  }

  if (fichaState.tipoInstalacion === 'CCTV' && fichaState.camaras.length > 0) {
    txt += `📹 CÁMARAS INSTALADAS (${fichaState.camaras.length})\n`;
    txt += `-----------------------------------\n`;
    fichaState.camaras.forEach(c => {
      txt += `CÁMARA ${c.numero} | ${c.modelo}\n`;
      txt += `  • IP: ${c.ip} | Canal: ${c.canal}\n`;
      txt += `  • Ubicación: ${c.ubicacion}\n\n`;
    });
  }

  if (g.observaciones) {
    txt += `📝 OBSERVACIONES:\n${g.observaciones}\n`;
  }

  const resContainer = document.getElementById('ft-resultado-container');
  const resArea = document.getElementById('ft-resultado-texto');
  if (resContainer && resArea) {
    resArea.value = txt;
    resContainer.classList.remove('hidden');
    resContainer.scrollIntoView({ behavior: 'smooth' });
  }
}

// 📋 Copiar al Portapapeles
function copiarAlPortapapeles() {
  const txt = document.getElementById('ft-resultado-texto').value;
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(txt).then(() => showToast('📋 Ficha copiada al portapapeles'));
  } else {
    const area = document.getElementById('ft-resultado-texto');
    area.select();
    document.execCommand('copy');
    showToast('📋 Ficha copiada al portapapeles');
  }
}

// 📤 Compartir vía Web Share API
function compartirFicha() {
  const txt = document.getElementById('ft-resultado-texto').value;
  if (navigator.share) {
    navigator.share({
      title: 'Ficha Técnica de Instalación',
      text: txt
    }).catch(() => {});
  } else {
    copiarAlPortapapeles();
  }
}

// 📝 Guardar en Notas de Apple (Flujo recomendado para iOS)
function guardarEnNotasApple() {
  copiarAlPortapapeles();
  alert("📋 Ficha copiada al portapapeles.\n\nAbre la aplicación Notas de Apple en tu iPhone y pégala en una nueva nota.");
}

